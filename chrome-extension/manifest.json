{
  "manifest_version": 3,
  "name": "Mause Seri Tık",
  "version": "1.0.1",
  "description": "Seçtiğiniz Chrome sekmesinde sol fare tuşunu seri tıklamaya dönüştürür.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mause Seri Tık",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
